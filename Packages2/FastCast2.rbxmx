	},

	FastCastEventsConfig = {
		UseLengthChanged = false,
		UseHit = true,
		UsePierced = true,
		UseCastTerminating = true,
		UseCanPierce = true,
		UseCastFire = true
	}
} :: TypeDef.FastCastBehavior

return Defaults]]></ProtectedString>
